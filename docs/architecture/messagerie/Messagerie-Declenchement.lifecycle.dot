digraph MessagerieDeclenchement {
  graph [rankdir=TB, fontname="Helvetica", label="V1 — Goulotte de déclenchement de la messagerie\nQuestion : à quel moment exact la conversation s'ouvre-t-elle ?  →  TOUJOURS dans activateRecovery(), quelle que soit la voie de paiement (Mobile Money, points, webhook, cron).\nTraits pleins = prouvé par le code · tirets = à construire · pointillés = unknown/hypothèse · orange = voie de paiement non Mobile Money, souvent oubliée", labelloc=t, nodesep=0.4, ranksep=0.6];
  node [fontname="Helvetica", fontsize=10, style="rounded,filled", fillcolor="#f5f5f5"];
  edge [fontname="Helvetica", fontsize=8];

  client [shape=ellipse, fillcolor="#E8F5EE", label="Client / propriétaire\ndecl.reporter_type='USER'"];
  finder [shape=ellipse, fillcolor="#E8F5EE", label="Trouveur\ndecl.reporter_type = 'USER' ou 'PARTENAIRE'\n55_create_partenaire_standalone.sql:55-64"];

  subgraph cluster_prouve {
    graph [label="EXISTANT — prouvé par le code", style="rounded,dashed", color="#666666", fontsize=11];

    matching [label="Matching score >= 80 → CONFIRMED\nmatching.service.ts:132-138\nhandleHighConfidenceMatch() 500-549"];
    notifs [label="Notifications MATCH_FOUND / MATCH_POTENTIAL\nnotification.service.ts:336 · createNotification() 73-108"];
    payreq [label="POST /api/payment/pay-recovery\npayment.routes.ts:49 → payRecovery() 180-320"];
    nokash [shape=box3d, fillcolor="#fff3e0", label="NoKash (Mobile Money)\nnokash.service.ts"];
    tx [shape=cylinder, label="transactions\nstatus PENDING → SUCCESS"];
    poll [label="startNokashPaymentPolling\npayment.controller.ts:433-457"];
    seam [shape=doublecircle, fillcolor="#ffe6e6", style="rounded,filled,bold", label="SEAM = 1 FONCTION, 6 POINTS D'APPEL\npayment_status='PAID' · claims.status='PAID'\ngénère le verification_code :349\nactivateRecovery() 325-422"];
    findernotif [label="NOTIF 'PAYMENT_PENDING' au trouveur\npayment.controller.ts:409-417"];
    modecontact [fillcolor="#fffde7", label="declarations.mode_contact='APP_CHAT'\n05_documents.sql:34 · declaration.dto.ts:111-112\nAUCUNE lecture de cette colonne aujourd'hui"];

    webhook [label="webhook NoKash\nnokashCallback → payment.controller.ts:78"];
    bypoints [fillcolor="#fff3e0", label="PAIEMENT EN POINTS (sans Mobile Money)\nisPoints → activateRecovery immédiat\npayment.controller.ts:287"];
    initiate [label="initiateRecovery() (portail déclaration)\ndeclaration.service.ts:683 → polling :735"];
    reconcile [fillcolor="#fff3e0", label="CRON de rattrapage des transactions bloquées\nreconcileStuckTransactions → cron.utils.ts:37\npayment-reconciliation.service.ts:97, 165"];
  }

  subgraph cluster_nouveau {
    graph [label="À CONSTRUIRE — v1 messagerie (in-app uniquement)", style="rounded", color="#2D5A42", fontsize=11];

    openconv [label="messagingService.openConversationForClaim()\nappelée depuis activateRecovery() — idempotente"];
    convtab [shape=cylinder, label="conversations\nclaim_id · lost_id · found_id\nstatus OPEN|CLOSED|ARCHIVED\nmigration 69 — H1/H2 hypothétiques"];
    partab [shape=cylinder, label="conversation_participants\nactor_type USER|PARTENAIRE + actor_id\nlast_read_at — patron de 56_notification_destinataire.sql"];
    msgtab [shape=cylinder, label="messages\nconversation_id · sender_type\nsender_id · body · kind TEXT|SYSTEM"];
    rooms [label="rooms Socket.IO « conv-{id} »\nsocket.service.ts:83-86 ne connaît que 'admin'"];
    uimap [shape=box, fillcolor="#e3f2fd", label="UI /messagerie\nMessagerie.tsx:17 coquille vide (conversations=[])\nroute App.tsx:122 · Sidebar.tsx:35"];
    guard [shape=diamond, fillcolor="#fce4ec", label="Garde : sender dans participants\nET conversation.status='OPEN'"];
  }

  unknowns [shape=note, fillcolor="#fafafa", style="rounded,filled,dashed", label="UNKNOWN — à trancher avant codage\nH3 : le chat peut-il échanger téléphone / email ?\ndeclaration.service.ts:180-188 rend déjà des coordonnées\nH4 : le portail partenaire n'initialise aucun socket\nseuls Dashboard.tsx:107, NotificationDropdown.tsx:65,\nNotificationModal.tsx:27, AdminMatchingMonitor.tsx:148 le font"];

  client -> payreq [label="paie les frais de récupération"];
  client -> matching [label="déclaration LOST", style=dashed];
  finder -> matching [label="déclaration FOUND", style=dashed];
  matching -> notifs [label="émet, sans mise en relation directe"];
  payreq -> nokash [label="initie le paiement"];
  payreq -> bypoints [label="branchement isPoints (rédemption de points)", style=bold, color="#E65100"];
  payreq -> tx [label="INSERT PENDING :270-284"];
  tx -> poll [label="ping 5 s"];
  poll -> seam [label="SUCCESS (polling payRecovery :304)", style=bold];
  poll -> initiate [label="même helper de polling", style=dashed, color="#666666"];
  initiate -> seam [label="SUCCESS", style=bold];
  webhook -> seam [label="SUCCESS callback :78", style=bold];
  bypoints -> seam [label="instantané, 0 Mobile Money :287", style=bold, color="#E65100"];
  reconcile -> seam [label="rattrapage cron :97 et :165", style=bold, color="#E65100"];
  seam -> findernotif [label="createNotification"];
  seam -> modecontact [label="devrait lire", style=dotted, color="#999999"];
  seam -> openconv [label="ouverture APRÈS paiement confirmé (décision client)", style=bold, color="#2D5A42"];
  openconv -> convtab [label="INSERT"];
  openconv -> partab [label="2 INSERT (owner + finder)"];
  partab -> convtab [label="clé étrangère"];
  uimap -> guard [label="POST message", style=dashed];
  guard -> msgtab [label="persiste si autorisé", style=dashed];
  msgtab -> rooms [label="MESSAGE_NEW", style=dashed];
  rooms -> uimap [label="temps réel", style=dashed];
  partab -> guard [label="vérifie membership", style=dashed, color="#2D5A42"];
  unknowns -> guard [label="définit le filtrage", style=dotted];
  unknowns -> openconv [label="bloque le build", style=dotted];
}
